package designcontractbridge
namespace designcontractbridge

entity DesignTokenInput id "gooo://design-contract-bridge/input/design-token"
entity DesignTokenIntent id "gooo://design-contract-bridge/intent/design-token"
entity GeneratedTokenArtifact id "gooo://design-contract-bridge/output/design-tokens"
entity GeneratedCSSArtifact id "gooo://design-contract-bridge/output/component-css"
entity GenerationReceipt id "gooo://design-contract-bridge/output/generation-receipt"
entity ClaimGraph id "gooo://design-contract-bridge/output/claim-graph"
entity ReaderResolution id "gooo://design-contract-bridge/evaluator/reader-resolution"
entity UnknownCausality id "gooo://design-contract-bridge/evaluator/unknown-causality"
entity RefutationCase id "gooo://design-contract-bridge/evaluator/refutation-case"
entity AuthorityBoundary id "gooo://design-contract-bridge/evaluator/authority-boundary"

activity DeclareCanvasToken(DesignTokenInput) -> DesignTokenIntent computes "design.token:v2;cell=foundation.core-release;proof=FOUNDATION;indicator=DRIVER;axis=CORE_RELEASE;name=color.surface.canvas;value=#F7F8FA;property=--color-surface-canvas;role=surface;claim=claim.design.surface;artifact=design-tokens.json"
activity DeclarePrimaryTextToken(DesignTokenInput) -> DesignTokenIntent computes "design.token:v2;cell=foundation.spec-release;proof=FOUNDATION;indicator=DRIVER;axis=SPEC_RELEASE;name=color.text.primary;value=#18202A;property=--color-text-primary;role=text;claim=claim.design.primary;artifact=design-tokens.json"
activity DeclareSpacingToken(DesignTokenInput) -> DesignTokenIntent computes "design.token:v2;cell=foundation.design-release;proof=FOUNDATION;indicator=DRIVER;axis=DESIGN_RELEASE;name=space.3;value=12px;property=--space-3;role=spacing;claim=claim.design.space;artifact=design-tokens.json"
activity DeclareRadiusToken(DesignTokenInput) -> DesignTokenIntent computes "design.token:v2;cell=foundation.meta-activity-authority;proof=FOUNDATION;indicator=DRIVER;axis=META_ACTIVITY_AUTHORITY;name=radius.md;value=8px;property=--radius-md;role=radius;claim=claim.design.radius;artifact=design-tokens.json"

activity ProjectTokenArtifact(DesignTokenIntent) -> GeneratedTokenArtifact computes "design.projection:v2;cell=coherence.claim-disposition-source;proof=COHERENCE;indicator=OUTCOME;axis=CLAIM_DISPOSITION_SOURCE;artifact=design-tokens.json;format=gooo.design-tokens/v2"
activity ProjectCSSArtifact(DesignTokenIntent) -> GeneratedCSSArtifact computes "design.projection:v2;cell=coherence.product-projection;proof=COHERENCE;indicator=OUTCOME;axis=PRODUCT_PROJECTION;artifact=component.css;format=css-custom-properties/v2"
activity BindGenerationReceipt(GeneratedTokenArtifact) -> GenerationReceipt computes "design.projection:v2;cell=coherence.eight-file-envelope;proof=COHERENCE;indicator=OUTCOME;axis=EIGHT_FILE_ENVELOPE;artifact=generation-receipt.json;bundle_files=8"
activity BindClaimGraph(GenerationReceipt) -> ClaimGraph computes "design.projection:v2;cell=coherence.consumer-semantic-match;proof=COHERENCE;indicator=OUTCOME;axis=CONSUMER_CLAIM_GRAPH;artifact=claim-graph.json;claim_count=4;consumer_receipt=consumer-receipt.json"

activity ResolveReaderResolutions(ClaimGraph) -> ReaderResolution computes "design.reader:v2;cell=regression.reader-resolution;proof=REGRESSION;indicator=GUARDRAIL;axis=READER_RESOLUTION;resolutions=EXACT|ROLE|EXISTENCE;observed=role|state;visual_similarity=insufficient;artifact=match-report.json"
activity PreserveUnknownCausality(ReaderResolution) -> UnknownCausality computes "design.guardrail:v2;cell=regression.unknown-causality;proof=REGRESSION;indicator=GUARDRAIL;axis=UNKNOWN_CAUSALITY;fields=stage|step|reason|unknown_class|next_operation|blocked_by;frontier=preserved;artifact=challenge-report.json"
activity EnforceRefutedPrecedence(UnknownCausality) -> RefutationCase computes "design.guardrail:v2;cell=regression.refuted-counterexamples;proof=REGRESSION;indicator=GUARDRAIL;axis=REFUTED_COUNTEREXAMPLES;precedence=REFUTED_OVER_UNKNOWN;status_order=REFUTED|UNKNOWN|CLOSED;fixed_point=FAIL_CLOSED;artifact=challenge-report.json"
activity EnforceAuthorityBoundary(RefutationCase) -> AuthorityBoundary computes "design.guardrail:v2;cell=regression.authority-boundary;proof=REGRESSION;indicator=GUARDRAIL;axis=AUTHORITY_BOUNDARY;repository_writes=0;output_scope=caller-owned;artifact=actions.json"
